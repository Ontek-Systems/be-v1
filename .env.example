# Base URL of the Blissful Escapes API, including the version segment.
# Read at build time only: the site is a static export, so this value is baked
# into the bundle and a production build without it will call localhost.
# Used by the public enquiry form (POST /trip-enquiries).
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Canonical origin of the deployed site, no trailing slash. Drives canonical
# URLs, the sitemap, Open Graph tags and robots.txt. Leave unset for the GitHub
# Pages preview, which is deliberately marked noindex when this is absent.
NEXT_PUBLIC_SITE_URL=https://www.blissfulescapes.co.uk

# Sub path the site is served from. Leave unset (or "/") on its own domain.
# The GitHub Pages preview is served from /be-v1.
NEXT_PUBLIC_BASE_PATH=
